@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bruno Carraro | Fullstack Developer</title>

    <script src="https://cdn.jsdelivr.net/npm/kute.js@2.1.2/dist/kute.min.js"></script>

    <link rel="stylesheet" href="@Url.Content("~/css/StyleSheet.css")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet" />
</head>
<body>

     <!-- Primeira Seção --> 
     <section class="First">


         
            <div class="content"> 
                <h1 class="name dynamic-text">Bruno<br />Carraro</h1>
                <h2 class="title dynamic-text">Fullstack<br />Developer</h2>
                <h3 class="stack dynamic-text">.NET<br />React</h3>
                <a href="#skills"><div class="arrow">⌄</div></a>

         
         </div> 
     </section> 


    <!-- Seção Skills -->
    <section class="Skills" id="skills">

        <div class="skills-container">
            <span class="skill">Skills →</span>
            <span class="skill">C#</span>
            <span class="skill">.NET</span>
            <span class="skill">React</span>
            <span class="skill">SLA</span>
        </div>

        <svg class="blob-motion"
             id="visual"
             viewBox="0 0 960 540"
             width="960"
             height="540"
             xmlns="http://www.w3.org/2000/svg"
             xmlns:xlink="http://www.w3.org/1999/xlink"
             version="1.1">
            <g transform="translate(450.7256843113689 283.4942824330989)">
                <path id="blob1"
                      d="M148.7 -134.9C193.7 -103.7 231.9 -51.9 232.4 0.6C233 53 196.1 106.1 151.1 128.6C106.1 151.1 53 143 -4.4 147.4C-61.8 151.8 -123.5 168.5 -151.2 146C-178.8 123.5 -172.4 61.8 -172.8 -0.4C-173.1 -62.5 -180.3 -124.9 -152.6 -156.1C-124.9 -187.3 -62.5 -187.1 -5.3 -181.8C51.9 -176.5 103.7 -166 148.7 -134.9"
                      fill="#fff"></path>
            </g>
            <g transform="translate(509.54377535978017 281.49390864595887)" style="visibility: hidden">
                <path id="blob2"
                      d="M115.4 -137.9C137.9 -92.9 136.4 -46.4 133.6 -2.8C130.8 40.8 126.6 81.6 104.1 118.4C81.6 155.2 40.8 188.1 -8.4 196.5C-57.5 204.8 -115 188.7 -151 151.9C-187 115 -201.5 57.5 -190.8 10.7C-180.1 -36.1 -144.1 -72.1 -108.1 -117.1C-72.1 -162.1 -36.1 -216.1 5.2 -221.2C46.4 -226.4 92.9 -182.9 115.4 -137.9"
                      fill="#fff"></path>
            </g>
        </svg>

        <a href="#projects"><div class="arrow">⌄</div></a>
    </section>

   
    <!-- Seção Projetos -->
    <section class="Projects" id="projects">
    <h2 class="section-title">Projetos</h2>

        <div class="projects-container">
            <button class="carousel-button prev">←</button>
            <div class="Projects_Carousel" id="projects-carousel-container">
            </div>
            <button class="carousel-button next">→</button>
        </div>

        <a href="#contact"><div class="arrow">⌄</div></a>
</section>

    <!-- Seção Contato -->
    <section class="Contact" id="contact">

        <h2 class="section-title">Pode me achar por aqui :) </h2>

       <div class="contact-links">

    <a href="https://www.linkedin.com/in/obrunocarraro/" target="_blank" rel="noopener noreferrer">
        <img src="~/imgs/Icons/Icon_Linkedin.svg" alt="Logo LinkedIn" >
    </a>
    <a href="https://github.com/carrarook" target="_blank" rel="noopener noreferrer">
        <img src="~/imgs/Icons/Icon_GitHub.svg" alt="Logo GitHub">
    </a>
    <a href="mailto:obrunocarraro@gmail.com">
        <img src="~/imgs/Icons/Icon_Email.svg" width="48px" alt="Logo Email">
    </a>
</div>
        <div class="signature">- Take your time</div>
    </section>


    <script>
        const tween = KUTE.fromTo(
          '#blob1',
          { path: '#blob1' },
          { path: '#blob2' },
          { repeat: 999, duration: 3000, yoyo: true }
        ).start();
    </script>

    <script src="~/js/site.js"></script>
</body>
</html>
